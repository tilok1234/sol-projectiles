{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tileforge.local/contracts/audio-roster.schema.json",
  "title": "Named Audio Roster",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "cues"],
  "properties": {
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "cues": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "status"],
        "properties": {
          "id": { "type": "string", "pattern": "^sfx\\.[a-z0-9_.-]+$" },
          "status": { "enum": ["named-only", "supplied", "approved"] }
        }
      }
    }
  }
}
